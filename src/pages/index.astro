---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- ═══════════════════════════════════════════════════════════════
       NAV
       ═══════════════════════════════════════════════════════════════ -->
  <nav class="fixed top-0 left-0 right-0 z-40 border-b border-edge/50 backdrop-blur-xl bg-void/80">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <span class="font-mono font-bold text-neon text-lg tracking-tight">PSN</span>
        <span class="text-ash text-sm hidden sm:inline">Post Shit Now</span>
      </a>

      <div class="hidden md:flex items-center gap-8 text-sm text-ash">
        <a href="#features" class="hover:text-snow transition-colors">Features</a>
        <a href="#how-it-works" class="hover:text-snow transition-colors">How It Works</a>
        <a href="#platforms" class="hover:text-snow transition-colors">Platforms</a>
        <a href="#teams" class="hover:text-snow transition-colors">Teams</a>
      </div>

      <a href="#get-started" class="px-4 py-2 bg-neon/10 text-neon border border-neon/20 rounded-lg text-sm font-medium hover:bg-neon/20 transition-all">
        Get Started
      </a>
    </div>
  </nav>


  <!-- ═══════════════════════════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════════════════════════ -->
  <section class="relative min-h-screen flex flex-col items-center justify-center pt-16 overflow-hidden">
    <!-- Background -->
    <div class="absolute inset-0 z-0">
      <img src="/hero-background.png" alt="" class="w-full h-full object-cover opacity-50" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-void via-void/40 to-void/80"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <!-- Badge -->
      <div class="fade-up inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-neon/20 bg-neon/5 text-neon text-sm font-mono mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-neon animate-pulse"></span>
        CLI-First Social Media
      </div>

      <!-- Headline -->
      <h1 class="fade-up stagger-1 font-mono font-bold text-snow text-5xl sm:text-6xl lg:text-7xl leading-[1.1] tracking-tight mb-6">
        Stop Overthinking.<br />
        <span class="neon-glow text-neon">Start Posting.</span>
      </h1>

      <!-- Subheadline -->
      <p class="fade-up stagger-2 text-ash text-lg sm:text-xl max-w-2xl mx-auto leading-relaxed mb-10">
        A terminal-first social media system that learns your voice, generates content that sounds like
        <em class="text-snow not-italic font-medium">you</em>, and posts across X, LinkedIn, Instagram, and TikTok.
        No web app. No dashboard. Just commands.
      </p>

      <!-- Terminal mockup -->
      <div class="fade-up stagger-3 hero-float mb-10">
        <img
          src="/terminal-mockup.png"
          alt="PSN terminal showing /psn:post command generating a voice-matched draft"
          class="w-full max-w-2xl mx-auto rounded-lg drop-shadow-[0_20px_60px_rgba(0,255,136,0.12)]"
          loading="eager"
        />
      </div>

      <!-- CTAs -->
      <div class="fade-up stagger-4 flex flex-col sm:flex-row items-center justify-center gap-4 mb-10">
        <a href="#get-started" class="px-8 py-3.5 bg-neon text-void font-semibold rounded-lg hover:bg-neon-dim transition-colors text-base">
          Clone the Repo &rarr;
        </a>
        <a href="#how-it-works" class="px-8 py-3.5 border border-edge text-ash rounded-lg hover:border-edge-light hover:text-snow transition-all text-base">
          See How It Works
        </a>
      </div>

      <!-- Platform icons -->
      <div class="fade-up stagger-5 flex items-center justify-center gap-6 text-smoke text-sm">
        <span>Works with</span>
        <div class="flex items-center gap-4">
          <!-- X -->
          <svg class="w-5 h-5 text-ash hover:text-snow transition-colors" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
          <!-- LinkedIn -->
          <svg class="w-5 h-5 text-ash hover:text-snow transition-colors" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          <!-- Instagram -->
          <svg class="w-5 h-5 text-ash hover:text-snow transition-colors" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
          <!-- TikTok -->
          <svg class="w-5 h-5 text-ash hover:text-snow transition-colors" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Bottom gradient fade -->
    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-void to-transparent z-10"></div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════
       THE PROBLEM
       ═══════════════════════════════════════════════════════════════ -->
  <section class="relative py-28 sm:py-36">
    <div class="max-w-6xl mx-auto px-6">
      <!-- Section label -->
      <div class="fade-up text-center mb-4">
        <span class="font-mono text-neon text-sm tracking-widest uppercase">$ the_problem</span>
        <span class="cursor-blink text-neon ml-0.5">_</span>
      </div>

      <h2 class="fade-up stagger-1 font-mono font-bold text-snow text-3xl sm:text-4xl lg:text-5xl text-center mb-6 leading-tight">
        You Know You Should Post.<br />You Just&hellip; Don't.
      </h2>

      <p class="fade-up stagger-2 text-ash text-center max-w-xl mx-auto mb-16 text-lg">
        The tools are broken. The process is painful. So you don't post.
      </p>

      <!-- Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Blank Page -->
        <div class="fade-up stagger-1 card-glow bg-surface border border-edge rounded-2xl p-8">
          <div class="w-12 h-12 rounded-xl bg-neon/10 border border-neon/20 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/>
            </svg>
          </div>
          <h3 class="font-mono font-semibold text-snow text-lg mb-3">The Blank Page Problem</h3>
          <p class="text-ash leading-relaxed">You open Twitter. Stare at the compose box. Close it. Repeat tomorrow. Sound familiar?</p>
        </div>

        <!-- SaaS Fatigue -->
        <div class="fade-up stagger-2 card-glow bg-surface border border-edge rounded-2xl p-8">
          <div class="w-12 h-12 rounded-xl bg-neon/10 border border-neon/20 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <h3 class="font-mono font-semibold text-snow text-lg mb-3">SaaS Tool Fatigue</h3>
          <p class="text-ash leading-relaxed">Buffer, Hootsuite, Sprout Social — $50-300/month for features you use 10% of. And your posts still sound like a marketing bot.</p>
        </div>

        <!-- AI Slop -->
        <div class="fade-up stagger-3 card-glow bg-surface border border-edge rounded-2xl p-8">
          <div class="w-12 h-12 rounded-xl bg-neon/10 border border-neon/20 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 8V4H8"/><rect x="4" y="8" width="16" height="12" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>
            </svg>
          </div>
          <h3 class="font-mono font-semibold text-snow text-lg mb-3">AI Slop</h3>
          <p class="text-ash leading-relaxed">Generic AI content gets suppressed by algorithms and ignored by humans. Platforms are actively detecting and downranking it.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════
       THE SOLUTION
       ═══════════════════════════════════════════════════════════════ -->
  <section class="relative py-28 sm:py-36">
    <!-- Subtle glow -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <div class="w-[600px] h-[600px] bg-neon/[0.03] rounded-full blur-[120px]"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-6">
      <div class="fade-up text-center mb-4">
        <span class="font-mono text-neon text-sm tracking-widest uppercase">$ the_solution</span>
        <span class="cursor-blink text-neon ml-0.5">_</span>
      </div>

      <h2 class="fade-up stagger-1 font-mono font-bold text-snow text-3xl sm:text-4xl lg:text-5xl text-center mb-6 leading-tight">
        Your Terminal Is Your<br /><span class="text-neon neon-glow">Social Media Command Center</span>
      </h2>

      <p class="fade-up stagger-2 text-ash text-center max-w-2xl mx-auto mb-16 text-lg leading-relaxed">
        PSN is a git repo you clone. It becomes your social media workspace — voice profiles, content drafts, analytics, strategy config. All version-controlled. All yours.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- One Command -->
        <div class="fade-up stagger-1 card-glow bg-surface border border-edge rounded-2xl p-8">
          <div class="w-12 h-12 rounded-xl bg-neon/10 border border-neon/20 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="4,17 10,11 4,5"/><line x1="12" y1="19" x2="20" y2="19"/>
            </svg>
          </div>
          <h3 class="font-mono font-semibold text-snow text-lg mb-3">One Command to Post</h3>
          <p class="text-ash leading-relaxed">Type <code class="font-mono text-neon text-sm bg-neon/10 px-1.5 py-0.5 rounded">/psn:post</code>. Get a voice-matched draft in seconds. Review, edit, schedule. Done.</p>
        </div>

        <!-- Learns Voice -->
        <div class="fade-up stagger-2 card-glow bg-surface border border-edge rounded-2xl p-8">
          <div class="w-12 h-12 rounded-xl bg-neon/10 border border-neon/20 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/>
              <path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/>
              <path d="M12 5v13"/>
            </svg>
          </div>
          <h3 class="font-mono font-semibold text-snow text-lg mb-3">It Learns Your Voice</h3>
          <p class="text-ash leading-relaxed">A voice interview captures how you actually talk. Every edit you make teaches the system. Posts get better over time — not generic, <em class="text-snow not-italic">yours</em>.</p>
        </div>

        <!-- BYOK -->
        <div class="fade-up stagger-3 card-glow bg-surface border border-edge rounded-2xl p-8">
          <div class="w-12 h-12 rounded-xl bg-neon/10 border border-neon/20 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 18v3c0 .6.4 1 1 1h4v-3h3v-3h2l1.4-1.4a6.5 6.5 0 1 0-4-4Z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/>
            </svg>
          </div>
          <h3 class="font-mono font-semibold text-snow text-lg mb-3">Bring Your Own Keys</h3>
          <p class="text-ash leading-relaxed">Your API keys, your data, your costs. No middleman billing. No vendor lock-in. Cancel nothing — it's a git repo.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════
       FEATURES
       ═══════════════════════════════════════════════════════════════ -->
  <section id="features" class="relative py-28 sm:py-36">
    <div class="max-w-6xl mx-auto px-6">
      <div class="fade-up text-center mb-4">
        <span class="font-mono text-neon text-sm tracking-widest uppercase">$ features</span>
        <span class="cursor-blink text-neon ml-0.5">_</span>
      </div>

      <h2 class="fade-up stagger-1 font-mono font-bold text-snow text-3xl sm:text-4xl lg:text-5xl text-center mb-16 leading-tight">
        Everything You Need.<br />Nothing You Don't.
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Voice Profiles -->
        <div class="fade-up stagger-1 card-glow bg-surface border border-edge rounded-2xl p-8">
          <div class="w-12 h-12 rounded-xl bg-neon/10 border border-neon/20 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 10v3"/><path d="M6 6v11"/><path d="M10 3v18"/><path d="M14 8v7"/><path d="M18 5v13"/><path d="M22 10v3"/>
            </svg>
          </div>
          <h3 class="font-mono font-semibold text-snow text-lg mb-3">Voice Profiles</h3>
          <p class="text-ash leading-relaxed">Three personas: Personal, Brand Operator, Brand Ambassador. Each with its own voice DNA. Switch between them per post.</p>
        </div>

        <!-- Smart Scheduling -->
        <div class="fade-up stagger-2 card-glow bg-surface border border-edge rounded-2xl p-8">
          <div class="w-12 h-12 rounded-xl bg-neon/10 border border-neon/20 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
            </svg>
          </div>
          <h3 class="font-mono font-semibold text-snow text-lg mb-3">Smart Scheduling</h3>
          <p class="text-ash leading-relaxed">Trigger.dev handles the automation. Schedule posts, collect analytics, refresh tokens — all running in the cloud while you sleep.</p>
        </div>

        <!-- Content Intelligence -->
        <div class="fade-up stagger-3 card-glow bg-surface border border-edge rounded-2xl p-8">
          <div class="w-12 h-12 rounded-xl bg-neon/10 border border-neon/20 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6"/><path d="M8 11h6"/>
            </svg>
          </div>
          <h3 class="font-mono font-semibold text-snow text-lg mb-3">Content Intelligence</h3>
          <p class="text-ash leading-relaxed">Trend monitoring from Hacker News, Reddit, Product Hunt, RSS feeds. The system surfaces what's relevant to your content pillars.</p>
        </div>

        <!-- Idea Bank -->
        <div class="fade-up stagger-4 card-glow bg-surface border border-edge rounded-2xl p-8">
          <div class="w-12 h-12 rounded-xl bg-neon/10 border border-neon/20 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/>
              <path d="M9 18h6"/><path d="M10 22h4"/>
            </svg>
          </div>
          <h3 class="font-mono font-semibold text-snow text-lg mb-3">Idea Bank</h3>
          <p class="text-ash leading-relaxed">Capture ideas instantly with <code class="font-mono text-neon text-sm bg-neon/10 px-1.5 py-0.5 rounded">/psn:capture</code>. They mature through a pipeline: spark &rarr; seed &rarr; ready &rarr; developed.</p>
        </div>

        <!-- Weekly Planning -->
        <div class="fade-up stagger-5 card-glow bg-surface border border-edge rounded-2xl p-8">
          <div class="w-12 h-12 rounded-xl bg-neon/10 border border-neon/20 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/>
              <path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/>
            </svg>
          </div>
          <h3 class="font-mono font-semibold text-snow text-lg mb-3">Weekly Planning</h3>
          <p class="text-ash leading-relaxed"><code class="font-mono text-neon text-sm bg-neon/10 px-1.5 py-0.5 rounded">/psn:plan</code> generates your content calendar. Series-first slotting, pillar balancing, content recycling. Review once, post all week.</p>
        </div>

        <!-- Learning Loop -->
        <div class="fade-up stagger-6 card-glow bg-surface border border-edge rounded-2xl p-8">
          <div class="w-12 h-12 rounded-xl bg-neon/10 border border-neon/20 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-neon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22,7 13.5,15.5 8.5,10.5 2,17"/><polyline points="16,7 22,7 22,13"/>
            </svg>
          </div>
          <h3 class="font-mono font-semibold text-snow text-lg mb-3">Learning Loop</h3>
          <p class="text-ash leading-relaxed">Analytics feed a preference model that gets smarter weekly. It learns which hooks, formats, and topics work for <em class="text-snow not-italic font-medium">your</em> audience.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════
       HOW IT WORKS
       ═══════════════════════════════════════════════════════════════ -->
  <section id="how-it-works" class="relative py-28 sm:py-36">
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <div class="w-[800px] h-[400px] bg-neon/[0.02] rounded-full blur-[120px]"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-6">
      <div class="fade-up text-center mb-4">
        <span class="font-mono text-neon text-sm tracking-widest uppercase">$ how_it_works</span>
        <span class="cursor-blink text-neon ml-0.5">_</span>
      </div>

      <h2 class="fade-up stagger-1 font-mono font-bold text-snow text-3xl sm:text-4xl lg:text-5xl text-center mb-20 leading-tight">
        Three Steps. Five Minutes.
      </h2>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-6">
